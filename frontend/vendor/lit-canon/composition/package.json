  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mathisarends/lit-canon.git",
    "directory": "packages/composition"
  },
  "homepage": "https://github.com/mathisarends/lit-canon/tree/main/packages/composition#readme",
  "bugs": {
    "url": "https://github.com/mathisarends/lit-canon/issues"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
