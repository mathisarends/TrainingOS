{
  "name": "lit-canon-api",
  "version": "1.0.0",
  "description": "Generate typed TypeScript API clients, query keys and TanStack Lit Query options from OpenAPI.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mathisarends/lit-canon.git",
    "directory": "packages/api"
  },
  "homepage": "https://github.com/mathisarends/lit-canon/tree/main/packages/api#readme",
  "bugs": {
    "url": "https://github.com/mathisarends/lit-canon/issues"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "lit-canon-api": "./lib/cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@orval/core": "8.38.0",
    "jiti": "2.6.1",
    "orval": "8.38.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3"
  },
  "keywords": [
    "openapi",
    "openapi-client",
    "orval",
    "lit",
    "lit-query",
    "lit-canon",
    "web-components",
    "typescript",
    "tanstack-query",
    "codegen",
    "api-client"
  ]
}
